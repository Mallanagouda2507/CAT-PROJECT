# Google Cloud Document AI Invoice Parser settings
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_CLOUD_PROCESSOR_ID=

# OCR.space OCR API key (keep the real value only in your local .env file).
OCR_SPACE_API_KEY=

# Optional: path to a service-account JSON file.
# Prefer Application Default Credentials (`gcloud auth application-default login`)
# during local development. Never commit credential files.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Flask secret for deployments; local development has a safe fallback.
FLASK_SECRET_KEY=
